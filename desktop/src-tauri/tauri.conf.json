{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "致知花园桌面伴侣",
  "version": "0.2.3",
  "identifier": "com.knowledgegarden.companion",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "致知花园桌面伴侣",
      "width": 1320,
      "height": 900,
      "minWidth": 900,
      "minHeight": 650
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* https:; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/knowledge-garden-sidecar"],
    "resources": ["resources/tracememo/**/*", "resources/bilibili/**/*"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY_BEFORE_FIRST_RELEASE",
      "endpoints": [
        "https://github.com/REPLACE_OWNER/REPLACE_REPOSITORY/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}

# OpenAI-compatible API. Prefer `.\run.ps1 -SaveApiKey` for Windows DPAPI secure storage.
# Leave GARDEN_API_KEY empty here; only use this variable when you deliberately want session-level configuration.
GARDEN_API_KEY=
GARDEN_BASE_URL=https://api.deepseek.com
GARDEN_MODEL=deepseek-v4-flash
GARDEN_HOST=127.0.0.1
GARDEN_PORT=8765
GARDEN_FEED_INTERVAL_MINUTES=60
GARDEN_VAULT_INTERVAL_SECONDS=8

# TraceMemo Local HTTP API. Token can instead be entered once in “微信苗圃”
# and stored with Windows DPAPI; never commit a real Token here.
TRACEMEMO_BASE_URL=http://127.0.0.1:6131
TRACEMEMO_API_TOKEN=

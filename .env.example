# Main teaching model. The school GLM Coding Plan route is reused for question
# understanding by default.
# Leave GARDEN_API_KEY empty; prefer Windows DPAPI secure storage.
GARDEN_API_KEY=
GARDEN_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GARDEN_MODEL=glm-5.2

# Set this to glm only when deliberately running a GLM/DeepSeek A/B test.
GARDEN_UNDERSTANDING_PROVIDER=primary
# Optional dedicated GLM compatibility configuration.
GARDEN_UNDERSTANDING_API_KEY=
GARDEN_UNDERSTANDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GARDEN_UNDERSTANDING_MODEL=glm-4.5-airx
GARDEN_HOST=127.0.0.1
GARDEN_PORT=8765
GARDEN_FEED_INTERVAL_MINUTES=60
GARDEN_VAULT_INTERVAL_SECONDS=8

# Independent evaluation judge. The API key is normally stored with Windows
# DPAPI by run_evals.ps1 -SaveJudgeKey, not written here.
JUDGE_API_KEY=
JUDGE_BASE_URL=https://tokenhub.tencentmaas.com/v1
JUDGE_MODEL=kimi-k3
JUDGE_THINKING=disabled
JUDGE_TIMEOUT_SECONDS=90
JUDGE_METRIC_TIMEOUT_SECONDS=90
DEEP_JUDGE_TIMEOUT_SECONDS=150

# Full DeepDiagram backend. The local installer starts this on demand from run.ps1.
DEEPDIAGRAM_BASE_URL=http://127.0.0.1:8000
DEEPDIAGRAM_TIMEOUT_SECONDS=45

# TraceMemo Local HTTP API. Token can instead be entered once in “微信苗圃”
# and stored with Windows DPAPI; never commit a real Token here.
TRACEMEMO_BASE_URL=http://127.0.0.1:6131
TRACEMEMO_API_TOKEN=
